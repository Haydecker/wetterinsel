{
  "name": "wetterinsel",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "build:single": "tsc --noEmit && vite build --config vite.single.config.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.0.3"
  },
  "description": "Comic-style isometric weather island of your neighbourhood, built from OpenStreetMap and Open-Meteo data",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Haydecker/wetterinsel.git"
  },
  "homepage": "https://github.com/Haydecker/wetterinsel#readme",
  "keywords": [
    "weather",
    "openstreetmap",
    "open-meteo",
    "svg",
    "isometric",
    "kiosk",
    "docker"
  ]
}
